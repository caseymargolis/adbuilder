# =============================================================================
# Required
# =============================================================================
# Anthropic API key — used for analysis synthesis (Opus 4.7), ad generation
# (Opus 4.7), optimization (Opus 4.7), chat (Sonnet 4.6), and routing (Haiku 4.5).
ANTHROPIC_API_KEY=sk-ant-...

# Auth — single shared password gate. Leave both unset for an unauthenticated
# dev instance. In production, set BOTH.
ADMIN_PASSWORD=
AUTH_SECRET=                       # Random hex string, 32+ chars. Used to sign session cookies.

# =============================================================================
# Meta — needed to actually launch ads. Without these, mock mode is on.
# Use a single agency System User access token at the server level; per-client
# ad account ID + page ID are stored on each client record via the intake form.
# =============================================================================
META_ACCESS_TOKEN=                 # System User token from Meta Business Manager (long-lived) — fallback when client isn't OAuth-connected
META_AD_ACCOUNT_ID=                # OPTIONAL — per-client value on the client record overrides this
META_PAGE_ID=                      # OPTIONAL — same; per-client value wins
META_API_VERSION=v21.0
APP_BASE_URL=https://your-host.example.com   # Used by OAuth callbacks + when uploading edited videos to Meta

# --- Meta OAuth (recommended over manual paste) ---
# Create a Meta app at developers.facebook.com → Apps. Add the redirect URI to
# "Valid OAuth Redirect URIs" in App Settings → Basic → Facebook Login.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=           # Defaults to {APP_BASE_URL}/api/meta/oauth/callback

# --- Google Ads (optional second platform) ---
# Google Cloud → APIs → enable Google Ads API. OAuth client at
# console.cloud.google.com/apis/credentials. Developer token at
# ads.google.com/aw/apicenter (Apply for "Standard Access" for production).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=         # Defaults to {APP_BASE_URL}/api/google/oauth/callback
GOOGLE_ADS_DEVELOPER_TOKEN=

# =============================================================================
# Best-tool-per-job routing — every key below is independently optional.
# =============================================================================

# --- Brand asset extraction (Brandfetch) ---
BRANDFETCH_API_KEY=

# --- Deep web scraping (Firecrawl) ---
FIRECRAWL_API_KEY=

# --- Market research ---
EXA_API_KEY=
PERPLEXITY_API_KEY=
# Meta Ad Library API uses META_ACCESS_TOKEN above

# --- Voice-of-customer ---
APIFY_API_TOKEN=
# Reddit search uses the public free endpoint — no key needed.

# =============================================================================
# Image generation
# =============================================================================
IDEOGRAM_API_KEY=
BFL_API_KEY=
GOOGLE_API_KEY=
RECRAFT_API_KEY=
OPENAI_API_KEY=

# =============================================================================
# Video generation
# =============================================================================
RUNWAY_API_KEY=
KLING_API_KEY=
# GOOGLE_API_KEY covers Veo 3
# OPENAI_API_KEY covers Sora 2

# =============================================================================
# Persistence
# =============================================================================
# JSON file by default. Set DATABASE_URL to switch to Postgres.
DATABASE_URL=
# Remember to: npm install pg

# =============================================================================
# Media storage (edited videos, future generated assets)
# =============================================================================
# Vercel Blob — get from the Vercel dashboard. Falls back to public/uploads/
# locally when this is unset (don't ship to prod without it; Vercel's
# filesystem is ephemeral).
BLOB_READ_WRITE_TOKEN=

# =============================================================================
# Email — daily optimization digests
# =============================================================================
RESEND_API_KEY=
RESEND_FROM=Adwise <hello@yourshop.com>

# =============================================================================
# Headless site reader — only used as fallback when Firecrawl isn't configured.
# Install: npm install playwright && npx playwright install chromium
# =============================================================================
USE_HEADLESS_SITE_READER=

# =============================================================================
# Daily cron — protects /api/cron/optimize-all
# =============================================================================
CRON_SECRET=

# =============================================================================
# Optional — override the default model used by tasks not routed elsewhere
# =============================================================================
ANTHROPIC_MODEL=claude-opus-4-7
