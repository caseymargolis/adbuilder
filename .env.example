# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Meta Marketing API
# https://developers.facebook.com/docs/marketing-apis/
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000000
META_PAGE_ID=
META_API_VERSION=v21.0

# Optional: default model overrides
ANTHROPIC_MODEL=claude-opus-4-7

# Image generation providers (optional — any combination works, Claude routes)
IDEOGRAM_API_KEY=
BFL_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Video generation providers (optional — same routing story)
# GOOGLE_API_KEY covers Veo 3
# OPENAI_API_KEY covers Sora 2
RUNWAY_API_KEY=
KLING_API_KEY=

# Persistence — if DATABASE_URL is set we use Postgres; otherwise JSON file.
# Install the pg package first: npm install pg
DATABASE_URL=

# Headless site reader for JS-rendered sites (SPAs).
# Install: npm install playwright && npx playwright install chromium
USE_HEADLESS_SITE_READER=

# Daily cron — hits /api/cron/optimize-all. Required to run the scheduled pass.
CRON_SECRET=
