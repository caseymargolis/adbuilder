# =============================================================================
# Required
# =============================================================================
# Anthropic API key — used for analysis synthesis (Opus 4.7), ad generation
# (Opus 4.7), optimization (Opus 4.7), chat (Sonnet 4.6), and routing (Haiku 4.5).
ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# Meta — needed to actually launch ads. Without these, mock mode is on.
# =============================================================================
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000000
META_PAGE_ID=
META_API_VERSION=v21.0
# Note: META_ACCESS_TOKEN is also used by the Meta Ad Library lookup so we can
# see what competitors are running on Meta right now.

# =============================================================================
# Best-tool-per-job routing — every key below is independently optional.
# Skip what you don't need; the analyzer surfaces the gap.
# =============================================================================

# --- Brand asset extraction (Brandfetch) ---
# Pulls canonical logos, hex colors, and font names. Image generation gets
# real brand colors instead of guessing. Free tier: 1k requests/month.
# https://brandfetch.com/developers
BRANDFETCH_API_KEY=

# --- Deep web scraping (Firecrawl) ---
# Best LLM-aware scraper. Handles SPAs, returns clean Markdown, supports
# /map for ranked subpage discovery. Falls back to Playwright then fetch.
# https://firecrawl.dev
FIRECRAWL_API_KEY=

# --- Market research ---
# Exa: semantic web search for finding direct competitors with citations.
# https://exa.ai
EXA_API_KEY=

# Perplexity: live structured market reports with sources.
# https://docs.perplexity.ai
PERPLEXITY_API_KEY=

# --- Voice-of-customer ---
# Apify: Trustpilot/G2 review scraping. Cheap (~$0.001 per review).
# https://apify.com
APIFY_API_TOKEN=
# Reddit search uses the public free endpoint — no key needed.

# =============================================================================
# Image generation — providers Claude routes between
# =============================================================================
IDEOGRAM_API_KEY=    # Best for text-in-image
BFL_API_KEY=         # FLUX 1.1 Pro Ultra — best photoreal
GOOGLE_API_KEY=      # Imagen 4 (images) + Veo 3 (video)
RECRAFT_API_KEY=     # Best for brand-consistent vector design
OPENAI_API_KEY=      # gpt-image-1 (images) + Sora 2 (video) fallback

# =============================================================================
# Video generation
# =============================================================================
# GOOGLE_API_KEY covers Veo 3
# OPENAI_API_KEY covers Sora 2
RUNWAY_API_KEY=      # Runway Gen-4 — cinematic motion
KLING_API_KEY=       # Kling 2 — physics, food, liquids

# =============================================================================
# Persistence — JSON file by default. Set DATABASE_URL to switch to Postgres.
# =============================================================================
DATABASE_URL=
# Remember to: npm install pg

# =============================================================================
# Headless site reader — only used as fallback when Firecrawl isn't configured.
# Install: npm install playwright && npx playwright install chromium
# =============================================================================
USE_HEADLESS_SITE_READER=

# =============================================================================
# Daily cron — protects /api/cron/optimize-all
# =============================================================================
CRON_SECRET=

# =============================================================================
# Optional — override the default model used by tasks not routed elsewhere
# =============================================================================
ANTHROPIC_MODEL=claude-opus-4-7
